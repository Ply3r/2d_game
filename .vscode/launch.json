{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Testes (todos)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Testes (arquivo atual)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test"],
      "args": ["${file}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
